{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "unimod-framework",
  "version-string": "0.1.0",
  "description": "Universal Runtime Modding & Reverse Engineering Framework for Proprietary Game Engines",
  "dependencies": [
    "minhook",
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "dx11-binding",
        "win32-binding"
      ]
    },
    "sol2",
    "luajit",
    "spdlog"
  ]
}
